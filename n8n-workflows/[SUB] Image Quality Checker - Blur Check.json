        "method": "POST",
        "url": "http://127.0.0.1:8101/blur/directory",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "http-blur",
      "name": "Blur Check",
