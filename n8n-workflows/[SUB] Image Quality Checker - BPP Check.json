            "index": 0
          }
        ]
      ]
    },
    "Build Config": {
      "main": [
        [
          {
            "node": "BPP Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "BPP Check": {
      "main": [
        [
          {
            "node": "Split Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Results": {
      "main": [
        [
          {
            "node": "Filter Over-Compressed",
            "type": "main",
            "index": 0
          },
          {
            "node": "Filter OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
