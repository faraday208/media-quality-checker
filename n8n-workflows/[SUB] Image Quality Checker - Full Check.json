        "content": "### Valid + Process\nRotation düzeltildi\nMetadata temizlendi\nRGB'ye çevrildi",
        "height": 100,
        "width": 220,
        "color": 4
      },
      "id": "sticky-valid",
      "name": "Sticky Valid",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2860, -20]
    },
    {
