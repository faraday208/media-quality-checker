        "color": 2
      },
      "id": "sticky-invalid",
      "name": "Sticky Invalid",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2640, 380]
    },
    {
      "parameters": {
        "content": "### Quality Pipeline\nBlur → Brightness → Contrast → BPP",
