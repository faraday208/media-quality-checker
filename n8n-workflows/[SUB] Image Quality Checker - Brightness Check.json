      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Gelen parametreleri al\nconst input = items[0].json;\n\n// Zorunlu: directory\nif (!input.directory) {\n  throw new Error('directory parametresi zorunlu!');\n}\n\nconst config = {\n  directory: input.directory,\n  limit: input.limit || 0\n};\n\nreturn [{ json: config }];"
      },
      "id": "config-node",
      "name": "Build Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8101/brightness/directory",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "http-brightness",
      "name": "Brightness Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
